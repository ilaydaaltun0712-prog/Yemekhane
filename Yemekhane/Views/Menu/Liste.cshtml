@model List<Yemekhane.Models.Gun>
@{
    ViewData["Title"] = "Menü Listesi";
}

<h1 class="mb-4">Haftalık Menü</h1>

<div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
        <tr>
            <th style="width: 20%">Gün</th>
            <th>Menü</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var gun in Model)
        {
            <tr>
                <td><strong>@gun.Ad</strong></td>
                <td>
                    @if (gun.GunYemekleri.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var gy in gun.GunYemekleri.OrderBy(x => x.Id))
                            {
                                <li>@gy.Yemek.Ad</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">Menü henüz girilmedi</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>